poetry-generator/
│
├── data/
│   ├── raw/                     # Original raw data files
│   ├── processed/               # Cleaned and preprocessed data files
│   ├── shayari_db.csv           # The original CSV file containing poetry
│   └── train_test_split/        # Split datasets for training and testing
│
├── notebooks/                   # Jupyter notebooks for exploration and analysis
│   ├── data_exploration.ipynb   # Notebook for exploring the data
│   ├── model_training.ipynb      # Notebook for training the model
│   └── poetry_generation.ipynb   # Notebook for generating poetry
│
├── src/                         # Source code for the project
│   ├── __init__.py              # Makes src a package
│   ├── data_preprocessing.py     # Scripts for data cleaning and preprocessing
│   ├── model.py                  # Model architecture (transformer)
│   ├── train.py                  # Training script
│   ├── evaluate.py               # Evaluation script
│   ├── generate.py               # Poetry generation script
│   └── utils.py                  # Utility functions (e.g., for loading data, saving models)
│
├── config/                      # Configuration files
│   ├── config.yaml               # Configuration file for model parameters, training settings, etc.
│   └── requirements.txt          # Python package dependencies
│
├── logs/                        # Log files for training and evaluation
│   ├── training.log              # Log file for training process
│   └── evaluation.log            # Log file for evaluation results
│
├── models/                      # Directory to save trained models
│   ├── checkpoints/              # Model checkpoints during training
│   └── final_model.pth           # Final trained model
│
├── tests/                       # Unit tests for the project
│   ├── test_data_preprocessing.py # Tests for data preprocessing functions
│   ├── test_model.py             # Tests for model architecture
│   └── test_utils.py             # Tests for utility functions
│
├── .gitignore                    # Git ignore file
├── README.md                     # Project documentation
└── main.py                       # Main entry point for the application